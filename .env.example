# ---- Application ----
APP_ENV=development                # development | test | production
FRONTEND_ORIGIN=http://localhost:5173
WEB_PORT=8080                       # docker-compose: port the nginx frontend listens on

# ---- Secrets (generate fresh values for every environment) ----
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=

# ---- Datastores (local development; docker-compose overrides these) ----
# Use 127.0.0.1 rather than localhost: on Windows, localhost resolves to IPv6 (::1) first,
# and an IPv4-only Redis/Postgres then costs a ~2s refused-connection stall per new connection,
# which makes the worker health ping time out.
DATABASE_URL=postgresql+asyncpg://tmm:tmm@127.0.0.1:5432/tmm
REDIS_URL=redis://127.0.0.1:6379/0
POSTGRES_USER=tmm
POSTGRES_PASSWORD=tmm
POSTGRES_DB=tmm

# ---- Telegram (platform defaults; users can also supply their own in Settings) ----
# Create an application at https://my.telegram.org to obtain these.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---- Operation safety ----
INVITE_COOLDOWN_SECONDS=8
MAX_FLOOD_WAIT_SECONDS=3600         # Longer Telegram flood waits pause the operation instead of sleeping
ACCESS_TOKEN_TTL_MINUTES=720
COOKIE_SECURE=false                 # true behind HTTPS (forced on in production)
